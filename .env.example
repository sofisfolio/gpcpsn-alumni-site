# Copy to .env for LOCAL tooling only (Supabase CLI, backup scripts). Never commit .env.
# The browser code does NOT read this file: public values live in site/js/config.js.

# Supabase (Phase 2)
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=            # postgres connection string incl. password: SECRET, local/CI only
SUPABASE_ACCESS_TOKEN=      # personal access token for the CLI: SECRET

# NEVER place the service_role key in the website, the repo or the Cloudflare build.
# Email (Phase 8): SMTP credentials are entered in the Supabase dashboard, not here.
